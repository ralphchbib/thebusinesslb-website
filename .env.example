# Copy to .env.local for development, and set the same values in the Vercel
# project's Environment Variables for production.
#
# DATABASE_URL and RESEND_API_KEY are required — without them, forms will
# show a graceful error to visitors and log the failure server-side, but
# nothing will actually be saved or notified. See README.md for setup steps.

# ---- Database (Supabase Postgres) ----
# Supabase project → Settings → Database → Connection string → "Transaction pooler".
# Must use the pooler (port 6543), not the direct connection (port 5432) —
# Vercel's serverless functions open a new connection per invocation, which
# exhausts Postgres's direct connection limit almost immediately.
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- Email (Resend) ----
# API key from resend.com → API Keys.
# Also used by Payload's email adapter (payload.config.ts) for admin
# password-reset/verification email — same Resend account, no separate key.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (resend.com/domains).
# Leave unset to default to NOTIFICATION_EMAIL below. Use onboarding@resend.dev
# only for local testing — it can't deliver to arbitrary inboxes.
RESEND_FROM_EMAIL=hello@thebusinesslb.com
# Where new-lead notifications (assessment, contact, newsletter) are sent.
NOTIFICATION_EMAIL=hello@thebusinesslb.com

# ---- Site ----
# In production, also used by Payload (payload.config.ts) as serverURL and
# as the sole allowed origin in its cors/csrf lists — the admin panel and
# API are served from this same domain. Local dev always uses
# http://localhost:3000 for that purpose regardless of this value.
NEXT_PUBLIC_SITE_URL=https://thebusinesslb.com
NEXT_PUBLIC_WHATSAPP_NUMBER=96176126860
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
CALENDAR_BOOKING_URL=

# ---- Security ----
# Any random string — salts the hashed IP used for submission throttling.
# Generate one with: openssl rand -hex 32
IP_HASH_SALT=

# ---- CMS (Payload) ----
# Required — payload.config.ts throws on startup if this is unset. Any
# random string, signs Payload's auth cookies/tokens. Do not reuse across
# environments. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# ---- Preview / Draft Mode (Phase 5A) ----
# Required for the "Preview" button on Pages/Case Studies to work — without
# it, app/api/draft/route.ts always returns 401 and admin.preview (in
# payload/collections/Pages.ts and CaseStudies.ts) hides the button rather
# than link somewhere broken. Any random string, do not reuse across
# environments or reuse PAYLOAD_SECRET's value. Generate one with:
# openssl rand -hex 32
PREVIEW_SECRET=
